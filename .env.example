# ============================================
# Firebase Cloud Messaging (FCM) Configuration
# ============================================
# Enable/Disable FCM Push Notifications
# Set to 'true' to enable FCM (requires native build with npx expo run:android/ios)
# Set to 'false' to disable FCM (safe for Expo Go and development)
EXPO_PUBLIC_ENABLE_FCM=true

# ============================================
# API Configuration
# ============================================
# API Base URL
API_BASE_URL=https://localhost:8080/api

# Environment
NODE_ENV=development

# Public API URL for Expo
EXPO_PUBLIC_API_URL='https://leggy-uncalculably-karoline.ngrok-free.dev/api/'
EXPO_PUBLIC_API_URL='https://nikolas-unstrenuous-augustus.ngrok-free.dev/api/'

# Base Image URL
BASE_IMAGE_URL = 'https://nikolas-unstrenuous-augustus.ngrok-free.dev/images/';
